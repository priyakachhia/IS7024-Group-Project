@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var recommendations = Model.NeighborhoodDashboard
        .Where(neighborhood => neighborhood.PermitCount > 0)
        .OrderByDescending(neighborhood => neighborhood.PermitCount)
        .ThenBy(neighborhood => neighborhood.Name)
        .Take(3)
        .ToArray();
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-content">
            <p class="eyebrow">Available market: Cincinnati, OH</p>
            <h1 id="home-title">Find the right location<br /><span>for your business.</span></h1>
            <p class="hero-copy">Compare neighborhoods and make confident location decisions anywhere your business can grow.</p>
        </div>
        <form id="home-primary-form" method="post" class="home-panel">
            <div class="form-field">
                <label asp-for="BusinessType" class="form-label">Business type</label>
                <select asp-for="BusinessType" class="form-select" aria-describedby="BusinessType-validation">
                    <option value="">Select a business type</option>
                    @foreach (var businessType in Model.SupportedBusinessTypes)
                    {
                        <option value="@businessType">@businessType</option>
                    }
                </select>
                <span id="BusinessType-validation" asp-validation-for="BusinessType" class="validation-message"></span>
            </div>

            <div class="form-field neighborhood-field">
                <label for="neighborhood-search" class="form-label">Neighborhood</label>
                <div class="search-control">
                    <span class="search-icon" aria-hidden="true">⌕</span>
                    <input id="neighborhood-search" type="search" class="form-control" placeholder="Search Cincinnati neighborhoods" role="combobox" autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="neighborhood-results" aria-describedby="neighborhood-status NeighborhoodId-validation" />
                </div>
                <input asp-for="NeighborhoodId" id="neighborhood-id" type="hidden" />
                <div id="neighborhood-results" class="home-results" role="listbox" aria-label="Neighborhood results" hidden>
                    @foreach (var neighborhood in Model.AvailableNeighborhoods)
                    {
                        <button id="neighborhood-result-@neighborhood.Id" type="button" class="home-result" role="option" tabindex="-1" data-neighborhood-result data-neighborhood-id="@neighborhood.Id" data-neighborhood-name="@neighborhood.Name">@neighborhood.Name</button>
                    }
                </div>
                <p id="neighborhood-status" class="search-status" role="status" aria-live="polite" aria-atomic="true"></p>
                <span id="NeighborhoodId-validation" asp-validation-for="NeighborhoodId" class="validation-message"></span>
            </div>

            <button type="submit" class="home-submit">Analyze Location <span aria-hidden="true">→</span></button>
        </form>
    </section>

    <div class="home-content">
        <section class="dashboard-section" aria-labelledby="snapshot-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Cincinnati snapshot</p>
                    <h2 id="snapshot-title">Neighborhood signals</h2>
                </div>
                <span class="unavailable-label">@Model.NeighborhoodDashboard.Count supported neighborhoods · @Model.ReportingYear</span>
            </div>
            <div class="metric-grid">
                <article class="metric-card">
                    <span class="metric-icon metric-icon-green" aria-hidden="true">⌁</span>
                    <h3>Reported crimes</h3>
                    <p class="metric-value">@(Model.TotalCrimeCount?.ToString("N0") ?? "Unavailable")</p>
                    <small>Across the supported neighborhoods in @Model.ReportingYear.</small>
                </article>
                <article class="metric-card">
                    <span class="metric-icon metric-icon-blue" aria-hidden="true">↗</span>
                    <h3>Building permits issued</h3>
                    <p class="metric-value">@(Model.TotalPermitCount?.ToString("N0") ?? "Unavailable")</p>
                    <small>Across the supported neighborhoods in @Model.ReportingYear.</small>
                </article>
            </div>
        </section>

        <div class="dashboard-columns activity-columns">
            <section class="dashboard-card comparison-card" aria-labelledby="comparison-title">
                <div class="card-heading">
                    <div><h2 id="comparison-title">Neighborhood comparison</h2></div>
                    <span class="card-action">@Model.ReportingYear</span>
                </div>
                <div class="comparison-table-wrapper" tabindex="0" role="region" aria-labelledby="comparison-title">
                    <table class="comparison-table">
                        <caption class="visually-hidden">Reported crimes and building permits issued in @Model.ReportingYear</caption>
                        <thead>
                            <tr>
                                <th scope="col">Neighborhood</th>
                                <th scope="col">Reported crimes</th>
                                <th scope="col">Building permits</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var neighborhood in Model.NeighborhoodDashboard)
                            {
                                <tr data-map-neighborhood="@neighborhood.Name">
                                    <th scope="row">@neighborhood.Name</th>
                                    <td data-map-crimes>@(neighborhood.CrimeCount?.ToString("N0") ?? "Unavailable")</td>
                                    <td data-map-permits>@(neighborhood.PermitCount?.ToString("N0") ?? "Unavailable")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="dashboard-card map-card" aria-labelledby="map-title">
                <div class="card-heading">
                    <div><h2 id="map-title">Neighborhood activity map</h2></div>
                    <span class="card-action">@Model.ReportingYear</span>
                </div>
                <link rel="stylesheet"
                      href="@("https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css")"
                      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
                      crossorigin="anonymous" />

                <div id="neighborhood-map" role="region" aria-label="Map of supported Cincinnati neighborhoods"
                     aria-describedby="neighborhood-map-status"></div>
                <p id="neighborhood-map-status" class="small text-muted mt-2 mb-0" role="status">
                    Loading neighborhood boundaries…
                </p>
            </section>
        </div>

        <div class="dashboard-columns lower-columns">
            <section class="dashboard-card" aria-labelledby="recommendations-title">
                <div class="card-heading">
                    <h2 id="recommendations-title">Recommendations</h2>
                    <span class="card-action">@Model.ReportingYear</span>
                </div>
                @if (recommendations.Length > 0)
                {
                    <p class="small text-muted mb-2">Explore neighborhoods with the most building permits among the available results.</p>
                    <ul class="list-group list-group-flush">
                        @foreach (var neighborhood in recommendations)
                        {
                            <li class="list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center gap-2">
                                <a asp-page="/Analyze" asp-route-neighborhood="@neighborhood.Name"
                                   class="fw-semibold">@neighborhood.Name</a>
                                <span class="small text-muted text-end">@neighborhood.PermitCount.GetValueOrDefault().ToString("N0") permits</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small text-muted mb-0">Recommendations appear when building permit counts are available.</p>
                }
            </section>

            <section class="dashboard-card" aria-labelledby="recent-title">
                <div class="card-heading">
                    <h2 id="recent-title">Recent analyses</h2>
                    <span class="card-action">This browser</span>
                </div>
                <p id="recent-analyses-empty" class="small text-muted mb-0">
                    Run an analysis to start your history.
                </p>
                <ul id="recent-analyses-list" class="list-group list-group-flush" hidden></ul>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@("https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js")"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="anonymous"></script>
    <script>
        async function loadNeighborhoodMap() {
            const container = document.getElementById("neighborhood-map");
            const status = document.getElementById("neighborhood-map-status");
            const leaflet = window.L;

            try {
                if (!leaflet) throw new Error("Leaflet is unavailable.");

                const map = leaflet.map(container, { scrollWheelZoom: false })
                    .setView([39.12, -84.49], 12);
                leaflet.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(map);

                const countsByBoundary = new Map();
                for (const row of document.querySelectorAll("[data-map-neighborhood]")) {
                    const name = row.dataset.mapNeighborhood;
                    countsByBoundary.set(name.replace(/^Mount /, "Mt. "), {
                        name,
                        crimes: row.querySelector("[data-map-crimes]").textContent.trim(),
                        permits: row.querySelector("[data-map-permits]").textContent.trim()
                    });
                }

                const boundaryNames = [...countsByBoundary.keys()]
                    .map(name => "'" + name.replaceAll("'", "''") + "'");
                const endpoint = "https://services.arcgis.com/JyZag7oO4NteHGiq/ArcGIS/rest/services/Open_Data_Feature_Collection/FeatureServer/12/query";
                const query = new URLSearchParams({
                    where: `SNA_NAME IN (${boundaryNames.join(", ")})`,
                    outFields: "SNA_NAME",
                    outSR: "4326",
                    returnZ: "false",
                    returnM: "false",
                    f: "geojson"
                });
                const response = await fetch(`${endpoint}?${query}`);
                if (!response.ok) throw new Error("Boundary request failed.");

                const data = await response.json();
                if (!data.features?.length) throw new Error("No boundaries returned.");

                const boundaries = leaflet.geoJSON(data, {
                    style: { color: "#245d79", weight: 2, fillColor: "#4e9f9a", fillOpacity: 0.34 },
                    onEachFeature(feature, layer) {
                        const counts = countsByBoundary.get(feature.properties.SNA_NAME);
                        if (!counts) return;

                        const popup = document.createElement("div");
                        const title = document.createElement("strong");
                        title.textContent = counts.name;
                        const crimes = document.createElement("div");
                        crimes.textContent = `Reported crimes: ${counts.crimes}`;
                        const permits = document.createElement("div");
                        permits.textContent = `Building permits issued: ${counts.permits}`;
                        popup.append(title, crimes, permits);

                        const label = document.createElement("span");
                        label.textContent = counts.name;
                        layer.bindTooltip(label, { sticky: true }).bindPopup(popup);
                    }
                }).addTo(map);

                map.fitBounds(boundaries.getBounds(), { padding: [16, 16] });
                status.textContent = `${data.features.length} neighborhoods shown. Select an outline to see its counts.`;
            } catch {
                container.hidden = true;
                status.textContent = "The map couldn’t load. Neighborhood counts are in the comparison table.";
            }
        }

        function showRecentAnalyses() {
            const list = document.getElementById("recent-analyses-list");
            const empty = document.getElementById("recent-analyses-empty");
            list.replaceChildren();
            list.hidden = true;
            empty.hidden = false;
            empty.textContent = "Run an analysis to start your history.";

            try {
                const history = JSON.parse(localStorage.getItem("metrobiz.recentAnalyses") || "[]");
                if (!Array.isArray(history)) return;

                for (const entry of history.slice(0, 5)) {
                    if (typeof entry?.neighborhood !== "string" ||
                        typeof entry.businessType !== "string" ||
                        typeof entry.period !== "string" ||
                        !Number.isInteger(entry.score) || entry.score < 0 || entry.score > 100) {
                        continue;
                    }

                    const row = document.createElement("li");
                    row.className = "list-group-item bg-transparent px-0 d-flex justify-content-between align-items-center gap-2";

                    const details = document.createElement("div");
                    const name = document.createElement("strong");
                    name.textContent = entry.neighborhood;
                    const period = document.createElement("div");
                    period.className = "small text-muted";
                    period.textContent = `${entry.businessType} · ${entry.period}`;
                    details.append(name, period);

                    const score = document.createElement("span");
                    score.className = "small fw-semibold text-end flex-shrink-0";
                    score.textContent = `Score ${entry.score}/100`;

                    row.append(details, score);
                    list.append(row);
                }

                if (list.childElementCount > 0) {
                    list.hidden = false;
                    empty.hidden = true;
                }
            } catch {
                empty.textContent = "Analysis history is unavailable in this browser.";
            }
        }

        showRecentAnalyses();
        window.addEventListener("pageshow", event => {
            if (event.persisted) showRecentAnalyses();
        });
        loadNeighborhoodMap();
    </script>
}