@page
@using Cincy_Biz_Advisor.Models
@{
    ViewData["Title"] = "Community";
    var businessTypes = new[] { "Restaurant", "Coffee Shop", "Retail Store", "Fitness Center" };
}

<main class="container py-4">
    <h1 class="fw-bold">Community</h1>
    <p class="text-muted mb-4">
        Share business ideas and connect with potential partners, co-founders, and neighbors.
    </p>

    <div class="row g-3">
        <aside class="col-12 col-md-3" aria-label="Discussion filters">
            <div class="card p-3">
                <a href="#new-post" class="btn btn-danger w-100 mb-3">+ New Post</a>

                <label for="community-neighborhood" class="form-label">Neighborhood</label>
                <select id="community-neighborhood" class="form-select mb-3">
                    <option value="">All neighborhoods</option>
                    @foreach (var neighborhood in CincinnatiNeighborhoods.All)
                    {
                        <option value="@neighborhood.DisplayName">@neighborhood.DisplayName</option>
                    }
                </select>

                <label for="community-business" class="form-label">Business Type</label>
                <select id="community-business" class="form-select">
                    <option value="">All business types</option>
                    @foreach (var businessType in businessTypes)
                    {
                        <option value="@businessType">@businessType</option>
                    }
                </select>
            </div>
        </aside>

        <div class="col-12 col-md-9">
            <section class="card p-4 mb-3" aria-labelledby="discussions-heading">
                <h2 id="discussions-heading" class="h5">Discussions</h2>
                <p class="text-muted mb-0">No discussions yet.</p>
            </section>

            <section id="new-post" class="card p-4" aria-labelledby="new-post-heading">
                <h2 id="new-post-heading" class="h5">Write a post</h2>

                <label for="community-post-title" class="form-label">Title</label>
                <input id="community-post-title" class="form-control mb-3"
                       type="text" maxlength="120" />

                <label for="community-post-message" class="form-label">Message</label>
                <textarea id="community-post-message" class="form-control"
                          rows="5" maxlength="2000"></textarea>
            </section>
        </div>
    </div>
</main>